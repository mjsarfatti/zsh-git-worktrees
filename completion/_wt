#compdef wt

__wt_commands_and_branches() {
  _describe 'command' '(
    ls:"List current worktrees"
    switch:"Switch to another worktree (creates if does not exist)"
    rm:"Removes a worktree. If on current worktree, switches to main"
  )'
}

__wt_branches() {
  if [[ $words[2] == "ls" ]]; then
    return
  fi

  local -a branches
  if [[ $words[2] == "rm" ]]; then
    branches=(${(f)"$(git worktree list | awk '{ print $3 }' | sed -e 's/[[]//' -e 's/[]]//' | sort | uniq)"})
  else
    branches=(${(f)"$(git branch -a | grep -v 'remotes/origin/HEAD' | grep -v '^\*' | sed -E 's/ +|.*remotes\/origin\///g' | sort | uniq)"})
  fi
  _describe 'branch' branches
}

_wt() {
  local curcontext="$curcontext" ret=1

  _arguments -s \
    '1: :__wt_commands_and_branches' \
    '2: :__wt_branches' && ret=0

  return "$ret"
}

_wt "$@"
